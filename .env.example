# API (Hono) — set for Docker/ LAN use
PORT=3001
DATABASE_URL=postgres://projecterp:projecterp@localhost:15432/projecterp
SESSION_SECRET=change-me-in-production-32-chars-minimum-ok
# Production SPA: base URL the browser uses (no trailing slash)
VITE_API_URL=http://localhost:3001

# SAP read (API server) — on-demand; leave empty in dev
SAP_DATABASE_URL=
SAP_ECHO_MODE=true

# Web Push (optional)
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
