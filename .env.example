# --- docker-compose.prod.yml (Coolify / production stack) ---
POSTGRES_PASSWORD=change-me-strong-password
SESSION_SECRET=change-me-in-production-32-chars-minimum-ok
WEB_ORIGIN=https://erp.example.com

# --- Local dev (pnpm dev + docker compose postgres) ---
# API (Hono) — set for Docker/ LAN use
PORT=3001
DATABASE_URL=postgres://projecterp:projecterp@localhost:15432/projecterp
# Web client → API (baked at `pnpm build`). For nginx serving the SPA and proxying /api on the
# same host, leave empty or omit — otherwise the browser may call the wrong machine.
# Dev convenience only (not for LAN deploys): http://localhost:3001
VITE_API_URL=

# SAP read (API server) — on-demand; leave empty in dev
SAP_DATABASE_URL=
SAP_ECHO_MODE=true

# Web Push (optional)
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Due digests (Resend + 07:00 Australia/Brisbane scheduler)
RESEND_API_KEY=
EMAIL_FROM=ProjectERP <noreply@example.com>
CRON_SECRET=
DIGEST_TZ=Australia/Brisbane

# AI work-complete (Google AI Studio / Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional Chromium override (production uses @sparticuz/chromium by default)
# PUPPETEER_EXECUTABLE_PATH=
